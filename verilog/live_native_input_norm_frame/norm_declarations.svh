 // Input normalization uses the accepted SIMD block; no additional compute arrays.
 localparam logic[31:0] NormTagBase=32'h4e4f5200;
 string native_norm_root;
 logic norm_fixture_loaded=0,norm_phase=0,norm_cache_committed=0;
 bit corrupt_normalized_cache=$test$plusargs("CORRUPT_NORMALIZED_INPUT_CACHE");
 logic norm_cfg_valid=0,norm_cfg_ready;
 logic[31:0]norm_cfg_tag=0;
 logic[63:0]norm_cfg_epsilon=0;
 logic norm_stats_valid=0,norm_stats_ready,norm_stats_last=0;
 logic[255:0]norm_stats_data=0;
 logic[127:0]norm_stats_gamma=0;
 logic norm_replay_valid=0,norm_replay_ready,norm_replay_last=0;
 logic[255:0]norm_replay_data=0;
 logic[127:0]norm_replay_gamma=0;
 logic norm_out_valid,norm_out_ready,norm_out_last,norm_out_error;
 logic[31:0]norm_out_tag;
 logic[9:0]norm_out_index;
 logic[3:0]norm_out_count;
 logic[63:0]norm_out_activation;
 logic signed[8:0]norm_out_exponent;
 logic[7:0]norm_out_outliers,norm_out_negative;
 logic[255:0]norm_raw_words[768];
 logic[127:0]norm_gamma_words[256];
 logic[63:0]norm_epsilons[3],norm_expected_words[768],norm_cache[768];
 logic[8:0]norm_expected_exponents[3];
 logic signed[8:0]norm_observed_exponents[3];
 logic[7:0]norm_expected_outliers[768],norm_expected_negative[768];
 bit norm_written[768],norm_acknowledged[768],norm_terminal_seen[3];
 bit norm_write_pending=0,norm_write_held=0;
 logic[136:0]norm_held_output=0;
 logic[63:0]norm_pending_data=0;
 int norm_token=0,norm_writes=0,norm_acks=0,norm_pending_word=0,norm_write_delay=0,norm_reads=0;
 int norm_stats_words=0,norm_replay_words=0;
 logic[63:0]norm_corruption_before=0,norm_corruption_after=0;

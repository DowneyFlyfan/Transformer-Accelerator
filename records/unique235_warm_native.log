@file 1: # Preserve exact objects independently of timing-only write_sdc exports.
@file 2: proc tri233_preservation {source_sdc filename expected_count} {
    set input [open $source_sdc r]
    set targets [dict create]
    while {[gets $input line]>=0} {
        set line [string trim $line]
        if {![string match {set_dont_touch *} $line]} {continue}
        if {![regexp {^set_dont_touch \[get_cells \{([^{}]+)\}\]$} $line -> name] &&
            ![regexp {^set_dont_touch \[get_cells ([A-Za-z0-9_/]+)\]$} $line -> name]} {
            close $input;error "TRI223_UNSUPPORTED_PRESERVATION_SELECTOR $line"
        }
        if {[dict exists $targets $name]} {close $input;error "TRI223_DUPLICATE_PRESERVATION_TARGET $name"}
        dict set targets $name 1
    }
    close $input
    if {[dict size $targets]!=$expected_count || $expected_count<1} {error TRI223_PRESERVATION_TARGET_COUNT}
    set stream [open $filename w]
    puts $stream "expected_object\tactual_object\tdont_touch"
    foreach name [lsort [dict keys $targets]] {
        # Protection is physical metadata. Use database objects in placement
        # view; timing collections are unsupported in that view.
        set physical [get_db insts $name]
        set hierarchical [get_db hinsts $name]
        if {[llength $physical]+[llength $hierarchical]!=1} {close $stream;error "TRI223_PRESERVATION_TARGET_NOT_UNIQUE $name"}
        if {[llength $physical]==1} {set object [lindex $physical 0]} else {set object [lindex $hierarchical 0]}
        set actual [get_db $object .name]
        set protected [get_db $object .dont_touch]
        puts $stream "$name\t$actual\t$protected"
        if {$actual ne $name} {close $stream;error "TRI223_PRESERVATION_TARGET_NAME_CHANGED $name $actual"}
        if {![string is boolean -strict $protected]} {close $stream;error "TRI233_UNSUPPORTED_PRESERVATION_VALUE $name $protected"}
        if {!$protected} {close $stream;error "TRI223_PRESERVATION_TARGET_NOT_PROTECTED $name"}
    }
    close $stream
}
#@ End verbose source /home/downeyflyfan/Research_Projects/Hardware/Attention_Accelerator/syn/tri_oracle_preservation233.tcl
@file 14: set source_sdc $root/.cache/physical/synthesis/tri_oracle_predicted_feedforward_finish213/constraints.sdc
@file 15: proc tri235_constraints {tag} {
    global out source_sdc
    # Follow the working203 timing-view initialization, rather than querying
    # clocks from the unsupported unflattened placement view.
    unflatten_ilm
    set_ilm_type -model si
    flatten_ilm
    set stream [open $out/[set tag]_clocks.tsv w]
    puts $stream "view\tname\tdisplayed_period_ns\texported_period_ns"
    foreach view {setup_slow setup_typ hold_fast} {
        set_analysis_view -setup [list $view] -hold [list $view]
        set clocks [get_clocks core_clock]
        if {[sizeof_collection $clocks]!=1} {error "TRI235_VIEW_CLOCK_COUNT $view"}
        set filename $out/[set tag]_[set view].sdc
        write_sdc -view $view $filename
        set input [open $filename r];set text [read $input];close $input
        set matches [regexp -all -inline -line {^create_clock[^\n]*-period[ \t]+([0-9.eE+-]+)} $text]
        if {[llength $matches]!=2 || abs(double([lindex $matches 1])-1.72414)>0.00000001} {
            error "TRI235_EXPORTED_CLOCK_CHANGED $view $matches"
        }
        puts $stream "$view\t[get_object_name $clocks]\t[get_property $clocks period]\t[lindex $matches 1]"
    }
    close $stream
    set_analysis_view -setup {setup_slow setup_typ} -hold {hold_fast}
}
@file 40: proc tri235_parent_inventory {} {
    if {[llength [get_db insts]]!=673622 ||
        [llength [get_db insts -if {.base_cell.name == tri_oracle_sram_memory_compute}]]!=20 ||
        [llength [get_db insts -if {.base_cell.name == TS6N28HPCPSVTA16X128M2F}]]!=40} {
        error TRI235_WRONG_PARENT_INVENTORY
    }
}

  "completed_helper_source": "\"\"\"Create one full, unreduced native hierarchy model as a comparison control.\"\"\"\nfrom pathlib import Path\nimport datetime\nimport hashlib\nimport json\nimport os\nimport sys\n\nsys.dont_write_bytecode = True\nsys.path.insert(0, \"syn\")\nfrom tri_oracle_artifact_fingerprint import artifact_fingerprint\n\nproducer = json.loads(Path(\"records/sram_core_checkpoint44_qualification.json\").read_text())\nassert producer[\"native_physical_checks_passed\"]\nassert producer[\"output_database_fingerprint\"] == artifact_fingerprint(producer[\"output_database\"])\nbase = Path(\".cache/physical/pnr/tri_oracle_sram_memory_compute\")\nassert not (base / \"hierarchy_full_control_68\").exists()\navailable = int(next(l.split()[1] for l in Path(\"/proc/meminfo\").read_text().splitlines()\n                     if l.startswith(\"MemAvailable:\"))) * 1024\nassert available > 12 * 1024**3\nPath(\"records/sram_core_hierarchy68_launch.json\").write_text(json.dumps({\n    \"started_utc\": datetime.datetime.now(datetime.timezone.utc).isoformat(),\n    \"producer_database\": producer[\"output_database\"],\n    \"producer_fingerprint_verified\": True,\n    \"native_keep_all\": True,\n    \"purpose\": \"Compare full and compact core models in the identical parent wrapper and constraints. Standalone-to-wrapper timing differs, so compact-model timing is not yet qualified.\",\n    \"native_output_binding\": \"source_netlist_after.v; complete model catalogs and any shared directory links require a separate closed dependency inventory before use.\",\n    \"full_paper_results_matched\": False\n}, indent=2) + \"\\n\")\nos.environ.update(\n    TRI_ORACLE_TOP=\"tri_oracle_sram_memory_compute\",\n    TRI_ORACLE_PHYSICAL_STAGE=\"hierarchy_full_control_68\",\n    TRI_ORACLE_PHYSICAL_ENTRY=\"syn/tri_oracle_export_full_sram_core_hierarchy_control.tcl\",\n    TRI_ORACLE_PHYSICAL_MARKER=\"TRI_ORACLE_SRAM_CORE_FULL_HIERARCHY68_EXPORTED\",\n    TRI_ORACLE_PHYSICAL_OUTPUT=str(base / \"hierarchy_full_control_68/source_netlist_after.v\"),\n    TRI_ORACLE_PHYSICAL_ANON_GIB=\"14\", TRI_ORACLE_PHYSICAL_SECONDS=\"3600\")\nprint(\"Qualified full core verified; exporting unreduced hierarchy control\", flush=True)\nos.execvpe(\"bash\", [\"bash\", \"syn/run_tri_oracle_guarded_physical.sh\"], os.environ)\n",

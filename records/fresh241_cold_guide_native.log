@file 1: # Signal-net names may change; endpoint roles and leaf identities may not.
@file 2: proc tri215_snapshot {directory tag} {
    set cells [open $directory/[set tag]_cells.tsv w]
    puts $cells "instance\tmaster\tlocation\torientation\tstatus\tdont_touch"
    set count 0
    foreach instance [get_db insts] {
        puts $cells [join [list [get_db $instance .name] [get_db $instance .base_cell.name] \
            [get_db $instance .location] [get_db $instance .orient] \
            [get_db $instance .place_status] [get_db $instance .dont_touch]] "\t"]
        incr count
    }
    close $cells
    set ports [open $directory/[set tag]_ports.tsv w]
    puts $ports "port\tdirection"
    foreach port [get_db ports] {
        if {[get_db $port .direction] eq "out" && [llength [get_db $port .net]] != 1} {
            error "TRI215_UNSUPPORTED_OUTPUT_WITHOUT_NET [get_db $port .name]"
        }
        puts $ports "[get_db $port .name]\t[get_db $port .direction]"
    }
    close $ports
    set nets [open $directory/[set tag]_nets.tsv w]
    puts $nets "constant\tpower\tground\tdriver_pins\tdriver_ports\tload_pins\tload_ports"
    foreach net [get_db nets] {
        puts $nets [join [list [get_db $net .constant] [get_db $net .is_power] [get_db $net .is_ground] \
            [lsort [get_db $net .driver_pins.name]] \
            [lsort [get_db $net .driver_ports.name]] \
            [lsort [get_db $net .load_pins.name]] \
            [lsort [get_db $net .load_ports.name]]] "\t"]
    }
    close $nets
    set pins [open $directory/[set tag]_pins.tsv w]
    puts $pins "pin\tdirect_constant"
    foreach pin [get_db pins -if {.constant != no_constant}] {
        puts $pins "[get_db $pin .name]\t[get_db $pin .constant]"
    }
    close $pins
    return $count
}
@file 40: proc tri215_require_equal {directory reference candidate} {
    foreach kind {cells ports nets pins} {
        foreach tag [list $reference $candidate] {
            set filename $directory/[set tag]_[set kind].tsv
            exec env LC_ALL=C sort -S 64M -T $directory -o $filename.sorted $filename
        }
        if {[catch {exec cmp -s $directory/[set reference]_[set kind].tsv.sorted \
                $directory/[set candidate]_[set kind].tsv.sorted}]} {
            error "TRI215_SIGNAL_GRAPH_CHANGED $kind"
        }
    }
}
#@ End verbose source /home/downeyflyfan/Research_Projects/Hardware/Attention_Accelerator/syn/tri_oracle_unique215_snapshot.tcl
@file 9: proc tri241_pins {filename} {
    set block [get_db insts core0]
    if {[llength $block]!=1 || [get_db $block .base_cell.name] ne "tri_oracle_sram_memory_compute"} {error TRI241_MISSING_PHYSICAL_CORE}
    set stream [open $filename w]
    puts $stream "pin\tdirection\tnet\tconstant"
    foreach pin [get_db $block .pins] {puts $stream "[get_db $pin .name]\t[get_db $pin .direction]\t[get_db $pin .net.name]\t[get_db $pin .constant]"}
    close $stream
}
@file 17: proc tri241_full_evidence {} {
    global out
    set_ilm_type -model si
    flatten_ilm
    set count 0
    set stream [open $out/core_cells.tsv w]
    puts $stream "instance\tmaster\tlocation\torientation"
    foreach instance [get_db insts] {
        set name [get_db $instance .name]
        if {![string match {core0/*} $name]} {continue}
        puts $stream "$name\t[get_db $instance .base_cell.name]\t[get_db $instance .location]\t[get_db $instance .orient]"
        incr count
    }
    close $stream
    if {$count!=94471} {error TRI241_INCOMPLETE_ORIGINAL_CORE}
    foreach master {TS5N28HPCPSVTA32X128M2FW TS5N28HPCPSVTA512X64M4F TS6N28HPCPSVTA16X128M2F} expected {18 2 8} {
        if {[llength [get_db insts -if ".base_cell.name == $master"]]!=$expected} {error TRI241_WRONG_MEMORY_COUNT}
    }
    report_ilm_status > $out/model_status.rpt
    foreach view {setup_slow setup_typ hold_fast} {
        set_analysis_view -setup [list $view] -hold [list $view]
        if {[sizeof_collection [get_clocks core_clock]]!=1} {error TRI241_WRONG_CLOCK_COUNT}
        write_sdc -view $view $out/[set view].sdc
    }
    set_analysis_view -setup {setup_slow setup_typ} -hold {hold_fast}
}

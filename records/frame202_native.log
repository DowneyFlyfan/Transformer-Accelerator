@file 20:
@file 21: set core_blocks [get_db insts -if {.base_cell.name == tri_oracle_sram_memory_compute}]
@file 22: set aggregate_banks [get_db insts -if {.base_cell.name == TS6N28HPCPSVTA16X128M2F}]
@file 23: if {[llength $core_blocks] != 20 || [llength $aggregate_banks] != 40} {...}
@file 26: set original_macro_poses [dict create]
@file 27: set core_prefixes [dict create]
@file 28: set indexes [dict create]
@file 29: foreach instance [concat $core_blocks $aggregate_banks] {
    set name [get_db $instance .name]
    set master [get_db $instance .base_cell.name]
    if {[get_db $instance .place_status] ne "fixed" || [get_db $instance .orient] ne "r0"} {
        error "PARENT33_UNFIXED_OR_ROTATED_MACRO: $name"
    }
    if {$master eq $component} {
        if {![regexp {clusters\[([0-9]+)\]\.cluster/cores\[([0-9]+)\]$} $name -> cluster core] ||
            $cluster >= 5 || $core >= 4 || [llength [get_db $instance .pins]] != 3158} {
            error "PARENT33_WRONG_ORIGINAL_CORE_INTERFACE: $name"
        }
        set key core:$cluster:$core
        dict set core_prefixes $name 0
    } else {
        if {![regexp {clusters\[([0-9]+)\]\.cluster/aggregate_memory\[([0-9]+)\]$} $name -> cluster bank] ||
            $cluster >= 5 || $bank >= 8 || [llength [get_db $instance .pins]] != 268} {
            error "PARENT33_WRONG_AGGREGATE_INTERFACE: $name"
        }
        set key bank:$cluster:$bank
    }
    if {[dict exists $indexes $key]} {error "PARENT33_DUPLICATE_MACRO_INDEX: $key"}
    dict set indexes $key 1
    set_db $instance .dont_touch true
    dict set original_macro_poses $name [list $master [get_db $instance .location] \
        [get_db $instance .orient] [get_db $instance .place_status]]
}
@file 55: if {[dict size $indexes] != 60 || [dict size $core_prefixes] != 20} {...}
@file 56: proc tri_oracle_frame202_macro_poses {filename poses} {
    set stream [open $filename w]
    puts $stream "instance\tmaster\tlocation\torientation\tstatus"
    foreach name [lsort [dict keys $poses]] {puts $stream [join [linsert [dict get $poses $name] 0 $name] "\t"]}
    close $stream
}
@file 62: tri_oracle_frame202_macro_poses $out/macros_before.tsv $original_macro_poses
@file 63: set prefix_file [open $out/core_prefixes.txt w]
@file 64: foreach name [lsort [dict keys $core_prefixes]] {puts $prefix_file $name}
@file 65: close $prefix_file
@file 66: set original_parent_count [llength [get_db insts]]
@file 67: if {$original_parent_count <= 60} {...}
@file 68: proc tri_oracle_frame202_controller_snapshot {filename} {
    set stream [open $filename w]
    set count 0
    foreach cell [get_db insts] {
        set name [get_db $cell .name]
        if {![regexp {^numeric/engine/(gated/implementation/|backend/clusters\[[0-4]\]\.control/(down/engines\[[0-3]\]|projection/transfer)/implementation/)} $name]} {continue}
        puts $stream "$name\t[get_db $cell .base_cell.name]"
        incr count
    }
    close $stream
    if {$count!=382490} {error "FRAME202_MAPPED_CONTROL_CELL_COUNT_CHANGED $count"}
    exec env LC_ALL=C sort -S 64M -T $::env(TRI_ORACLE_FRAME202_OUTPUT) -o ${filename}.sorted $filename
    if {[catch {exec cmp -s ${filename}.sorted $::env(TRI_ORACLE_FRAME202_EXPECTED_CONTROLS)}]} {error FRAME202_ORIGINAL26_CONTROL_CELLS_CHANGED}
}
@file 82: tri_oracle_frame202_controller_snapshot $out/controller_cells_before.tsv
@file 83:
@file 84: proc tri_oracle_snapshot_complete_cores33 {filename expected_prefixes} {
    set counts $expected_prefixes
    set file [open $filename w]
    puts $file "instance\tmaster\tlocation\torientation"
    foreach instance [get_db insts] {
        set name [get_db $instance .name]
        if {![regexp {^(.*clusters\[[0-9]+\]\.cluster/cores\[[0-9]+\])/(.+)$} $name -> prefix local]} {continue}
        if {![dict exists $counts $prefix]} {error "PARENT33_UNEXPECTED_CORE_INTERNAL: $name"}
        dict incr counts $prefix
        puts $file "$name\t[get_db $instance .base_cell.name]\t[get_db $instance .location]\t[get_db $instance .orient]"
    }
    close $file
    foreach name [dict keys $counts] {
        if {[dict get $counts $name] != 94471} {
            error "PARENT33_INCOMPLETE_CORE_MODEL: $name [dict get $counts $name]"
        }
    }
    foreach master {TS5N28HPCPSVTA32X128M2FW TS5N28HPCPSVTA512X64M4F TS6N28HPCPSVTA16X128M2F} expected {360 40 200} {
        if {[llength [get_db insts -if ".base_cell.name == $master"]] != $expected} {
            error "PARENT33_WRONG_FULL_MEMORY_COUNT: $master"
        }
    }
    return 1889420
}

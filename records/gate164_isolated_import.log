@file(tri_oracle_import_private_gate164.tcl) 14: set stream [open $output/isolated_cells.tsv w]
@file(tri_oracle_import_private_gate164.tcl) 15: set cells [get_db [get_db designs $top] .insts]
@file(tri_oracle_import_private_gate164.tcl) 16: if {[llength $cells]<1000} {error GATE164_MAPPED_CELLS_MISSING}
@file(tri_oracle_import_private_gate164.tcl) 17: foreach leaf $cells {
    set master [get_db $leaf .base_cell.name]
    if {![string match *BWP12T40P140 $master]} {error GATE164_NONSTANDARD_LEAF}
    puts $stream "[get_db $leaf .name]\t$master"
}
@file(tri_oracle_import_private_gate164.tcl) 22: close $stream
@file(tri_oracle_import_private_gate164.tcl) 23: set stream [open $output/isolated_hierarchy.tsv w]
@file(tri_oracle_import_private_gate164.tcl) 24: foreach instance [get_db [get_db designs $top] .hinsts] {
    puts $stream "[get_db $instance .name]\t[get_db $instance .module.name]"
}
@file(tri_oracle_import_private_gate164.tcl) 27: close $stream
@file(tri_oracle_import_private_gate164.tcl) 28: write_hdl > $output/qualified_import.v
